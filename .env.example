# SIEM Log Correlation Engine - Environment Variables
# Copy this file to .env and update values as needed.

# Writable data root (optional; defaults to the repo in source mode and to
# %LOCALAPPDATA%\SIEM in the packaged desktop app)
# SIEM_HOME=C:\Users\you\AppData\Local\SIEM

# Path to main configuration file (optional, defaults to config/config.yaml)
SIEM_CONFIG=config/config.yaml

# SQLite database file path
SIEM_DATABASE_URL=sqlite:///data/siem.db

# Flask secret key (CHANGE THIS in production - generate with: python -c "import secrets; print(secrets.token_hex(32))")
SIEM_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Syslog listening ports (default 514 requires admin/root; use 5514 otherwise)
SIEM_SYSLOG_UDP_PORT=514
SIEM_SYSLOG_TCP_PORT=514

# Web dashboard
SIEM_WEB_HOST=0.0.0.0
SIEM_WEB_PORT=5000
SIEM_WEB_WORKERS=1

# Send session cookie only over HTTPS (set true behind a TLS reverse proxy)
SIEM_COOKIE_SECURE=false

# Logging level: DEBUG, INFO, WARNING, ERROR
SIEM_LOG_LEVEL=INFO

# HTTP ingestion API tokens for POST /api/ingest (comma-separated id:token pairs).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIEM_INGEST_TOKENS=agent-01:CHANGE_ME

# siem-agent connection settings (used by: siem-agent run / test-connection)
SIEM_AGENT_URL=http://127.0.0.1:5000
SIEM_AGENT_TOKEN=CHANGE_ME
